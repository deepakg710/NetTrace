# NetTrace Environment Configuration Example
NETTRACE_APP_NAME=NetTrace
NETTRACE_APP_VERSION=1.0.0
NETTRACE_MAX_UPLOAD_SIZE_MB=100

# Detection thresholds
NETTRACE_PORT_SCAN_THRESHOLD=15
NETTRACE_HOST_SCAN_THRESHOLD=10
NETTRACE_CONNECTION_BURST_THRESHOLD=20
NETTRACE_BURST_WINDOW_SECONDS=2.0
NETTRACE_REPEATED_DNS_QUERY_THRESHOLD=5
NETTRACE_PERIODIC_CONNECTION_MIN_COUNT=4
NETTRACE_PERIODIC_CV_THRESHOLD=0.2
NETTRACE_TRAFFIC_RATE_SPIKE_PPS=100.0
